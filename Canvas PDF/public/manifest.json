{
  "manifest_version": 3,
  "name": "Canvas PDF · PDF 編輯、OCR 與翻譯",
  "version": "0.1.1",
  "minimum_chrome_version": "157",
  "description": "在 Chrome 本機修改 PDF 段落、圖片與掃描頁，OCR 模型隨插件提供。",
  "action": { "default_title": "開啟 Canvas PDF" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "optional_host_permissions": [
    "https://gemini.google.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "index.html",
      "enabled": false,
      "can_embed": true
    }
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none';"
  }
}

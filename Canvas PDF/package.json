    "build": "tsc --noEmit && vite build && node scripts/package.mjs",
    "assets": "python scripts/prepare_assets.py"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "0.4.2",
    "@pdf-lib/fontkit": "1.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "onnxruntime-web": "1.30.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "onnxruntime-web": "$onnxruntime-web"
  }
}

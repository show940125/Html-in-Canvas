{
  "manifest_version": 3,
  "name": "Canvas Clipper 互動式閱讀桌",
  "version": "0.5.0",
  "description": "圖文摘錄、聚焦閱讀、並排比較、主題框、標籤、關係線與本機完整備份。",
  "minimum_chrome_version": "156",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Canvas Clipper"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; img-src 'self' blob:;"
  },
  "key": "",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
